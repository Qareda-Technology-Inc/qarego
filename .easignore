# EAS uploads from the git repo root, and this file replaces .gitignore for that upload.
# Only the mobile app (client/) is needed, so everything else is left out, then client's own
# caches, native folders and secrets.

# Everything at the top level except the client app
/*
!/client/

# Dependencies & caches
**/node_modules/
**/.expo/
**/.eas/
**/dist/
**/web-build/
**/.metro-health-check*
**/*.tsbuildinfo

# Native projects (EAS runs prebuild)
/client/ios/
/client/android/

# Secrets & local env. EAS gets env and Firebase files from its own environment variables.
**/.env
**/.env.*
!**/.env.example
/client/google-services.json
/client/GoogleService-Info.plist
/client/ServiceAccountQareGo.json
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# macOS / debug / misc
**/.DS_Store
npm-debug.*
yarn-debug.*
yarn-error.*
*.orig.*
/client/app-example/
/client/expo-env.d.ts

# Large media
*.mp4
*.mov
*.wav
*.mp3
