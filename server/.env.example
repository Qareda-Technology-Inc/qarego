# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/qarego

# development | production (local dev uses development; Render sets production)
NODE_ENV=development
PORT=2026
PUBLIC_API_URL=http://127.0.0.1:2026

# JWT
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=7d

# CORS — local dev
ADMIN_ORIGIN=http://localhost:3000
MERCHANT_ORIGIN=http://localhost:3001
# Production (Render): set to your Vercel URLs
# ADMIN_ORIGIN=https://your-admin.vercel.app
# MERCHANT_ORIGIN=https://your-merchant.vercel.app
# PUBLIC_API_URL=https://qarego.onrender.com

# --- Cloudinary (image uploads) ---
# Create free account: https://cloudinary.com/console
# Option A: paste full URL from Dashboard (recommended)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Option B: separate values (must match the same Cloudinary account)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional default folder in Cloudinary media library
CLOUDINARY_FOLDER=qarego

# --- Firebase Cloud Messaging (push) ---
# Firebase Console → Project settings → Service accounts → Generate new private key
# Paste the JSON as a single line, or set FIREBASE_SERVICE_ACCOUNT_PATH to the .json file path
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# SMS (Arkasel) — new-order alerts to vendor owners & cooks
ARKASEL_API_KEY=
ARKASEL_API_SECRET=
ARKASEL_SENDER_ID=QareGO

# Hubtel — collections (checkout) + disbursements (payouts / cash-out / food settlement)
# Collection account — customer checkout (items/initiate) + status checks:
HUBTEL_API_ID=
HUBTEL_API_KEY=
HUBTEL_MERCHANT_ACCOUNT_NUMBER=
# HTTP REST API credentials — required for txnstatus (api-txnstatus.hubtel.com).
# Create at https://unity.hubtel.com/account/api-accounts (type: Http Rest Api).
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
# Optional dedicated status API keys (else CLIENT_ID/SECRET are used for status):
HUBTEL_STATUS_API_ID=
HUBTEL_STATUS_API_KEY=
# Disbursement account — Send Money (rider cash-out, food split on DELIVERED).
HUBTEL_DISBURSEMENT_API_ID=
HUBTEL_DISBURSEMENT_API_KEY=
# Optional aliases (same as DISBURSEMENT_API_ID/KEY):
# HUBTEL_DISBURSEMENT_CLIENT_ID=
# HUBTEL_DISBURSEMENT_CLIENT_SECRET=
# Optional override (default: https://api.hubtel.com/v1)
HUBTEL_API_URL=
# Optional checkout/status base URLs (defaults are Hubtel production endpoints)
HUBTEL_CHECKOUT_API_URL=
HUBTEL_STATUS_API_URL=
# Optional callback/return URLs (BASE_URL fallback is used when omitted)
BASE_URL=
HUBTEL_CHECKOUT_CALLBACK_URL=
HUBTEL_CHECKOUT_RETURN_URL=
HUBTEL_CHECKOUT_CANCEL_URL=
HUBTEL_PAYOUT_CALLBACK_URL=

# Webhook security (STRONGLY recommended). Secret is embedded in the callbackUrl
# sent to Hubtel (?token=...) and verified on every incoming webhook, preventing
# spoofed "payment success" callbacks. Use a long random string.
HUBTEL_WEBHOOK_SECRET=
# Optional comma-separated IP allowlist for webhook callers.
HUBTEL_WEBHOOK_ALLOWED_IPS=

# Google Play / App Store review login (22222222 customer OTP 0000, 11111111 rider OTP 1111).
# Set to false to disable after review.
# REVIEW_LOGIN_ENABLED=true
